
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: These rules are intentionally permissive for development and debugging.
    // Any authenticated user can read and write to the entire database.
    // These rules should be properly secured before deploying to production.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
