
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // This rule allows a user to read and write to their own document
    // and any subcollections within it (like 'chats').
    // It also allows any authenticated user to read the top-level user profile
    // for discovery purposes, but not the subcollections.
    match /users/{userId} {
      allow get: if request.auth != null; // Anyone can get a user's profile for discovery.
      allow read, write: if request.auth.uid == userId; // User can read/write their own document and all subcollections.
    }

    // Any authenticated user can read/write messages in the top-level `chats` collection.
    // This collection holds the actual messages for all 1-on-1 chats.
    match /chats/{chatId}/messages/{messageId} {
        allow read, write: if request.auth != null;
    }

    // Any authenticated user can interact with status updates.
    match /status_updates/{statusId} {
      allow read, write: if request.auth != null;
    }

    // Any authenticated user can read affiliate products. Writes should be admin-only.
    // For simplicity now, allowing any authenticated user to write.
    match /affiliate_products/{productId} {
      allow read, write: if request.auth != null;
    }

    // Admin role check.
    match /roles_admin/{userId} {
      allow read: if request.auth != null;
    }
  }
}
