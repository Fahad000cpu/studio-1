
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow reading of all user profiles for discover page, 
    // but only allow a user to write to their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // Allow a user to read and write to their own chats subcollection
    match /users/{userId}/chats/{chatId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Allow any authenticated user to read/write messages in any chat.
    // More specific rules can be added later (e.g., only participants can read/write).
    match /chats/{chatId}/messages/{messageId} {
        allow read, write: if request.auth != null;
    }

    // Allow any authenticated user to read/write status updates.
    match /status_updates/{statusId} {
      allow read, write: if request.auth != null;
    }

    // Allow any authenticated user to read affiliate products.
    // Write access should be limited to admins in production.
    match /affiliate_products/{productId} {
      allow read, write: if request.auth != null;
    }

    // Allow any authenticated user to check for admin roles.
    match /roles_admin/{userId} {
      allow read: if request.auth != null;
    }
  }
}
