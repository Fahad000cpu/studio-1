
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Allow reading/listing of profiles for discovery by any authenticated user.
      allow get, list: if request.auth != null;
      // Allow a user to write only to their own profile.
      allow write: if request.auth.uid == userId;
    }

    match /chats/{chatId}/messages/{messageId} {
      // A user can create a message if they are the sender.
      allow create: if request.auth.uid == request.resource.data.senderId;

      // Participants can read or update messages (e.g., for "delete for me").
      // We check against the {chatId} wildcard from the path itself.
      allow read, update: if request.auth.uid in chatId.split('_');

      // Only the original sender can delete a message for everyone.
      allow delete: if request.auth.uid == resource.data.senderId;
    }

    // Statuses can be read by anyone, but only written/deleted by the owner.
    match /status_updates/{statusUpdateId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }

    // Affiliate products can be read by anyone, but only written by an admin.
    match /affiliate_products/{productId} {
      allow read: if request.auth != null;
      allow write: if exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Admin roles rules
    match /roles_admin/{userId} {
      // Allow a user to read their own role document.
      // Also, allow an existing admin to read (get/list) any role document.
      allow read: if request.auth.uid == userId || exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      
      // Only allow existing admins to write to the roles collection.
      allow write: if exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}
