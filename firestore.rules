
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // This rule allows a user to get their own document or any other user's document for discovery.
    // It also allows a user to write ONLY to their own document.
    match /users/{userId} {
      allow get: if request.auth != null; 
      allow write: if request.auth.uid == userId; 
    }

    // NEW, EXPLICIT RULE:
    // This rule allows a user to read and write documents within their OWN 'chats' subcollection.
    // This is required for fetching the chat list and fixes the permission denied error.
    match /users/{userId}/chats/{chatId} {
      allow read, write: if request.auth.uid == userId;
    }

    // This collection holds the actual messages for all 1-on-1 chats.
    match /chats/{chatId}/messages/{messageId} {
        allow read, write: if request.auth != null;
    }

    // Any authenticated user can interact with status updates.
    match /status_updates/{statusId} {
      allow read, write: if request.auth != null;
    }

    // Any authenticated user can read affiliate products. Writes should be admin-only.
    // For simplicity now, allowing any authenticated user to write.
    match /affiliate_products/{productId} {
      allow read, write: if request.auth != null;
    }

    // Admin role check.
    match /roles_admin/{userId} {
      allow read: if request.auth != null;
    }
  }
}
