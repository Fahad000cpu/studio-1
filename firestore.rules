
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read anyone's profile for discovery, but only write to their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // A user can read and write to the chat metadata documents in their own 'chats' subcollection.
    // This rule is crucial for listing the chats.
    match /users/{userId}/chats/{chatId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Any authenticated user can read/write messages in any chat's message subcollection.
    // This is broad for simplicity. In a real app, you'd restrict this to participants.
    match /chats/{chatId}/messages/{messageId} {
        allow read, write: if request.auth != null;
    }

    // Any authenticated user can interact with status updates.
    match /status_updates/{statusId} {
      allow read, write: if request.auth != null;
    }

    // Any authenticated user can read affiliate products. Writes should be admin-only.
    match /affiliate_products/{productId} {
      allow read, write: if request.auth != null;
    }

    // Any authenticated user can check for admin roles.
    match /roles_admin/{userId} {
      allow read: if request.auth != null;
    }
  }
}
