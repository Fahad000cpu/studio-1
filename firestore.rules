rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isUserInMemberList() {
      return 'memberIds' in resource.data && 
             resource.data.memberIds is list && 
             request.auth.uid in resource.data.memberIds;
    }
    
    function isSenderInMemberList() {
      return 'memberIds' in request.resource.data && 
             request.resource.data.memberIds is list && 
             request.auth.uid in request.resource.data.memberIds;
    }

    function isUserInGroup(groupId) {
      return request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // --- USER PROFILE RULES ---
    match /users/{userId} {
      // Any authenticated user can read profiles.
      allow get, list: if request.auth != null;
      
      // A user can create their own profile.
      allow create: if request.auth.uid == userId;

      // A user can update their own profile, or an admin can update any profile.
      allow update: if request.auth.uid == userId || exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));

      // Only admins can delete user profiles.
      allow delete: if exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));

      // --- NEW SUBCOLLECTION RULE for 1-on-1 Chat Metadata ---
      match /chats/{chatId} {
        // A user can only read and write to their own chat metadata subcollection.
        // This is secure because the query path is already scoped to the user's UID.
        allow read, write: if request.auth.uid == userId;
      }
    }

    // --- ADMIN ROLE RULES ---
    match /roles_admin/{userId} {
      // Only admins can read or write roles.
      allow read, write: if request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- 1-on-1 Chat Messages ---
    match /chats/{chatId}/messages/{messageId} {
      // READ: Allow reading if the user's UID is part of the memberIds list.
      allow read: if request.auth != null && isUserInMemberList();

      // CREATE: User can create a message if they are the sender AND in the member list.
      allow create: if request.auth != null &&
                      request.resource.data.senderId == request.auth.uid &&
                      isSenderInMemberList();

      // UPDATE: A member can update a message for deletion.
      allow update: if request.auth != null && isUserInMemberList() && (
          // Case 1: User is "deleting for me" - Simplified rule to be compatible with arrayUnion
          (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
          ) ||
          // Case 2: Sender is "deleting for everyone" (tombstoning)
          (
              request.auth.uid == resource.data.senderId &&
              request.time < resource.data.timestamp + duration.value(15, 'm') &&
              request.resource.data.messageType == 'deleted' &&
              request.resource.data.senderId == resource.data.senderId &&
              request.resource.data.timestamp == resource.data.timestamp &&
              request.resource.data.chatId == resource.data.chatId &&
              request.resource.data.memberIds == resource.data.memberIds
          )
      );

      // DELETE: Not allowed directly. Use update for tombstoning.
      allow delete: if false;
    }

    // --- Group Chat Messages ---
    match /groups/{groupId}/messages/{messageId} {
       // READ: Allow reading if the user is in the message's member list.
      allow read: if request.auth != null && isUserInMemberList();

      // CREATE: User can create a message if they are the sender AND are in the member list they provide.
      allow create: if request.auth != null &&
                      request.resource.data.senderId == request.auth.uid &&
                      isSenderInMemberList();

      // UPDATE: A member of the group can update a message for deletion.
      // This rule is simpler and relies on the fact that the user must be in the message's
      // memberIds list to even see it and attempt an update.
      allow update: if request.auth != null && isUserInMemberList() && (
          // Case 1: User is "deleting for me" - Simplified rule to be compatible with arrayUnion
          (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
          ) ||
          // Case 2: Sender is "deleting for everyone" (tombstoning)
          (
              request.auth.uid == resource.data.senderId &&
              request.time < resource.data.timestamp + duration.value(15, 'm') &&
              request.resource.data.messageType == 'deleted' &&
              request.resource.data.senderId == resource.data.senderId &&
              request.resource.data.timestamp == resource.data.timestamp &&
              request.resource.data.groupId == resource.data.groupId &&
              request.resource.data.memberIds == resource.data.memberIds
          )
      );

      // DELETE: Not allowed directly. Use update for tombstoning.
      allow delete: if false;
    }

    // --- GROUP CHAT RULES ---
    match /groups/{groupId} {
      // Allow reading a group document if the user is a member.
      allow get: if request.auth != null && isUserInMemberList();
      allow list: if request.auth != null && request.query.where.size() > 0 && request.query.where[0][2] == request.auth.uid;

      // A user can create a group IF they are the creator AND are in the member list.
      allow create: if request.auth != null && 
                     request.resource.data.creatorId == request.auth.uid &&
                     'memberIds' in request.resource.data &&
                     request.resource.data.memberIds is list &&
                     request.auth.uid in request.resource.data.memberIds;

      // The creator or an admin can update group details. Members can update to remove themselves.
      allow update: if request.auth != null && (
                     (resource.data.creatorId == request.auth.uid) || 
                     (exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))) ||
                     (
                       'memberIds' in resource.data && resource.data.memberIds is list &&
                       request.auth.uid in resource.data.memberIds &&
                       request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid]) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
                     )
                   );

      // The creator or an admin can delete a group.
      allow delete: if (request.auth != null && resource.data.creatorId == request.auth.uid) || (request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)));
    }

    // --- STATUS UPDATE RULES ---
    match /status_updates/{statusId} {
      // Any logged-in user can read status updates.
      allow read: if request.auth != null;
      
      // A user can only create a status for themselves.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Anyone can update 'likes' and 'views', but only the owner can change other fields.
      allow update: if (request.auth != null && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'views']) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']))) || 
                     (request.auth != null && request.auth.uid == resource.data.userId);
                     
      // The owner or an admin can delete a status.
      allow delete: if (request.auth != null && request.auth.uid == resource.data.userId) || (request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)));
    }

    // --- AFFILIATE PRODUCT RULES ---
    match /affiliate_products/{productId} {
      // Any logged-in user can view products.
      allow read: if request.auth != null;
      
      // Only admins can add, update, or delete products.
      allow write: if request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}