
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Allow reading/listing of profiles for discovery by any authenticated user.
      allow get, list: if request.auth != null;
      // Allow a user to write only to their own profile.
      allow write: if request.auth.uid == userId;

      // Nested rule for the chats sub-collection that stores metadata
      match /chats/{chatId} {
        // A user can read/write the chat metadata within their own user document.
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Rules for top-level chat messages
    match /chats/{chatId}/messages/{messageId} {
      // Participants can read messages.
      allow read: if request.auth.uid in chatId.split('_');

      // A user can create a message if they are the sender.
      allow create: if request.auth.uid == request.resource.data.senderId;

      // A participant can update a message (e.g., for "delete for me").
      allow update: if request.auth.uid in chatId.split('_');

      // Only the sender can delete a message for everyone.
      allow delete: if request.auth.uid == resource.data.senderId;
    }

    // Statuses can be read by anyone, but only written/deleted by the owner.
    match /status_updates/{statusUpdateId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }

    // Affiliate products can be read by anyone, but only written by an admin.
    match /affiliate_products/{productId} {
      allow read: if request.auth != null;
      allow write: if exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Admin roles can only be read/written by other admins.
    match /roles_admin/{userId} {
      allow read, write: if exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}
