rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================
    //     HELPER FUNCTIONS
    // =================================
    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // An admin user has a document with their UID in the 'roles_admin' collection.
      return isLoggedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // =================================
    //     USER PROFILES
    // =================================
    // Path: /users/{userId}
    // Users can read any profile, but only create/update their own. Admins have full access.
    match /users/{userId} {
      // Allow any logged-in user to read a profile (for discover, chat, etc.)
      allow get, list: if isLoggedIn();

      // A user can only create their own profile document.
      allow create: if request.auth.uid == userId;

      // A user can update their own profile, or an admin can update any profile.
      allow update: if request.auth.uid == userId || isAdmin();

      // Only admins can delete user profiles.
      allow delete: if isAdmin();
    }

    // =================================
    //     ADMIN ROLES
    // =================================
    // Path: /roles_admin/{userId}
    // Only admins can manage who is an admin.
    match /roles_admin/{userId} {
      // Allow admins to see who else is an admin.
      // Allow any logged-in user to check if THEY are an admin (for useAdmin hook).
      allow get: if isLoggedIn();
      allow list: if isAdmin();

      // Only admins can grant or revoke admin roles.
      allow create, delete: if isAdmin();

      // This document only marks a role, it has no data to update.
      allow update: if false;
    }


    // =================================
    //     1-on-1 CHAT METADATA
    // =================================
    // Path: /chat_metadata/{chatId}
    // This collection stores metadata for 1-on-1 chats to make loading lists faster.
    match /chat_metadata/{chatId} {
      // A user can read/write metadata only if they are a participant in that chat.
      // The `sendChatNotification` server action handles writes, but this rule provides client-side security.
      allow read, write: if isLoggedIn() && request.auth.uid in resource.data.participants;
    }


    // =================================
    //     1-on-1 CHAT MESSAGES
    // =================================
    // Path: /chats/{chatId}/messages/{messageId}
    // The chatId is a combination of two sorted user UIDs.
    match /chats/{chatId}/messages/{messageId} {
      function isParticipant() {
        return isLoggedIn() && (request.auth.uid in chatId.split('_'));
      }

      // Any participant can read messages in the chat.
      allow read: if isParticipant();

      // A user can create a message only if they are a participant and the senderId is their own.
      allow create: if isParticipant() && request.resource.data.senderId == request.auth.uid;

      // Allow "delete for me" (updates `deletedFor` array) and "delete for everyone".
      // Delete for me: any participant can do this.
      // Delete for everyone: only the original sender of the message.
      allow update: if isParticipant();
      allow delete: if isLoggedIn() && resource.data.senderId == request.auth.uid;
    }


    // =================================
    //     GROUP CHATS
    // =================================
    // Path: /groups/{groupId}
    match /groups/{groupId} {
      function isMember() {
        return isLoggedIn() && request.auth.uid in resource.data.memberIds;
      }

      function isCreator() {
        return isLoggedIn() && request.auth.uid == resource.data.creatorId;
      }
      
      // A user can read a group's details if they are a member.
      allow read: if isMember();
      
      // A user can create a group if they are the creator and are included in the initial member list.
      allow create: if isLoggedIn() &&
                     request.resource.data.creatorId == request.auth.uid &&
                     request.auth.uid in request.resource.data.memberIds;

      // Only the group creator or an admin can update the group details (e.g., name, description).
      allow update: if isCreator() || isAdmin();
      
      // Only the group creator or an admin can delete a group.
      allow delete: if isCreator() || isAdmin();
      
      // --- NESTED: GROUP MESSAGES ---
      // Path: /groups/{groupId}/messages/{messageId}
      match /messages/{messageId} {
        // We use a get() call here to check the membership from the parent group document.
        // This is secure and necessary for subcollections.
        function isGroupMember() {
            return isLoggedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }

        // A user can read messages if they are a member of the group.
        allow read: if isGroupMember();

        // A user can create a message if they are a member and the senderId matches their UID.
        allow create: if isGroupMember() && request.resource.data.senderId == request.auth.uid;
        
        // Messages are immutable as per the app's logic.
        allow update, delete: if false;
      }
    }


    // =================================
    //     STATUS UPDATES
    // =================================
    // Path: /status_updates/{statusId}
    match /status_updates/{statusId} {
      function isOwner() {
        return isLoggedIn() && request.auth.uid == resource.data.userId;
      }

      // Any logged-in user can view status updates.
      allow read: if isLoggedIn();

      // A user can only create a status for themselves.
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;

      // Allow updates only for liking or viewing. The rule checks that NO other fields are changed.
      allow update: if isLoggedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'views']);

      // The owner of the status or an admin can delete it.
      allow delete: if isOwner() || isAdmin();
    }


    // =================================
    //     AFFILIATE PRODUCTS
    // =================================
    // Path: /affiliate_products/{productId}
    match /affiliate_products/{productId} {
      // Any logged-in user can view the products.
      allow read: if isLoggedIn();

      // Only admins can create, update, or delete products.
      allow write: if isAdmin();
    }
    
    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
