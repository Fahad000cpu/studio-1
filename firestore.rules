
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper function to check for admin role.
    function isAdmin() {
      // An admin is a user whose UID exists as a document in the /roles_admin collection.
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- USER PROFILE RULES ---
    // Rule for the top-level 'users' collection documents.
    match /users/{userId} {
      // Allow any authenticated user to read user profiles (for discover page, etc.).
      allow get, list: if request.auth != null;
      // Allow a user to write to their own profile, or an admin to write to any profile.
      allow write: if request.auth.uid == userId || isAdmin();
    }
    
    // --- CHAT & GROUP RULES ---

    // Rules for one-on-one chat messages.
    match /chats/{chatId}/messages/{messageId} {
      function isChatParticipant() {
        return request.auth != null && request.auth.uid in chatId.split('_');
      }
      function isSender() {
        return request.auth != null && request.auth.uid == resource.data.senderId;
      }
      // Participants can read messages and create new ones.
      allow read, create: if isChatParticipant();
      allow update: if isChatParticipant(); // For "delete for me"
      allow delete: if isSender(); // For "delete for everyone"
    }
    
    // Rule for the 1-on-1 chat metadata collection.
    match /chat_metadata/{chatId} {
        // A user can read a chat's metadata if their UID is in the `participants` array.
        // This rule correctly secures list queries using `where('participants', 'array-contains', request.auth.uid)`.
        allow read: if request.auth != null && request.auth.uid in resource.data.participants;
        // Deny all client-side writes. Metadata is only written by the server action.
        allow write: if false;
    }

    // Rules for group metadata.
    match /groups/{groupId} {
      function isGroupCreator() {
        return request.auth != null && resource.data.creatorId == request.auth.uid;
      }
      
      // Allow reading (get/list) a group doc if the user is a member.
      // This correctly secures the 'array-contains' query on the 'groups' collection.
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      
      // Allow creating a group if the user is the creator listed in the new document.
      allow create: if request.auth != null && request.resource.data.creatorId == request.auth.uid;
      // Allow updating a group if the user is a member (e.g., to change name/description).
      allow update: if request.auth != null && request.auth.uid in resource.data.memberIds;
      // Only the group creator can delete the group.
      allow delete: if isGroupCreator();
    }

    // Rules for messages within a group.
    match /groups/{groupId}/messages/{messageId} {
      // This rule relies on a denormalized 'memberIds' array on the message document itself for efficient reads.
      function isMember() {
        return request.auth.uid in resource.data.memberIds;
      }
      // This rule checks the incoming document for writes to ensure the creator is a member.
      function isMemberOfNewMessage() {
        return request.auth.uid in request.resource.data.memberIds;
      }
      
      allow get, list: if isMember();
      allow create: if isMemberOfNewMessage() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false; // Group messages are immutable for now.
    }
    
    // --- OTHER TOP-LEVEL COLLECTIONS ---

    // Rules for status updates.
    match /status_updates/{statusId} {
        function isOwner() {
          return request.auth != null && request.auth.uid == resource.data.userId;
        }
        function isCreatingOwnStatus() {
           return request.auth != null && request.auth.uid == request.resource.data.userId;
        }
        function isUpdatingLikesOrViews() {
          let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
          return affectedKeys.hasOnly(['likes', 'views']) || affectedKeys.hasOnly(['likes']) || affectedKeys.hasOnly(['views']);
        }
        allow read: if request.auth != null;
        allow create: if isCreatingOwnStatus();
        allow update: if request.auth != null && isUpdatingLikesOrViews();
        allow delete: if isOwner();
    }

    // Rules for affiliate products.
    match /affiliate_products/{productId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Rules for managing who is an admin. Only other admins can change this.
    match /roles_admin/{userId} {
       allow get, list, create, delete: if isAdmin();
       allow update: if false; // Prevent accidental role changes. Deletion and creation is safer.
    }
  }
}
