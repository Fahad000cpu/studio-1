rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================
    //     USER PROFILES
    // =================================
    match /users/{userId} {
      // Any logged-in user can get or list profiles.
      // This is required for the Discover page, Admin panel, and creating new groups.
      allow get, list: if request.auth != null;
      
      // A user can create their own profile document.
      allow create: if request.auth.uid == userId;

      // A user can update their own profile, or an admin can update any profile.
      allow update: if (request.auth.uid == userId) || (exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)));

      // Only admins can delete user profiles.
      allow delete: if exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // =================================
    //     ADMIN ROLES
    // =================================
    match /roles_admin/{userId} {
      // Only an admin can read the admin roles list.
      allow read: if exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      
      // Only an admin can grant or revoke admin roles.
      allow write: if exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // =================================
    //     1-on-1 CHAT METADATA
    // =================================
    match /chat_metadata/{chatId} {
      // A user can read (get/list) chat metadata ONLY if they are a participant.
      // This rule works with the client-side query: `where('participants', 'array-contains', auth.uid)`.
      allow read: if request.auth.uid in resource.data.participants;

      // A user can create new chat metadata ONLY if they are included in the participants list.
      allow create: if request.auth.uid in request.resource.data.participants;

      // A user can update metadata (like last message) ONLY if they are a participant.
      // We use `get()` to check the existing document's state before allowing the update.
      allow update: if request.auth.uid in get(/databases/$(database)/documents/chat_metadata/$(chatId)).data.participants;
      
      // Deleting chat metadata is not allowed for users.
      allow delete: if false;
    }

    // =================================
    //     1-on-1 CHAT MESSAGES
    // =================================
    match /chats/{chatId}/messages/{messageId} {
      // A user can read/write messages in a chat ONLY if their UID is part of the chatId.
      // This pattern assumes chatId is 'uid1_uid2'.
      allow read, write: if request.auth.uid in chatId.split('_');
    }

    // =================================
    //     GROUP CHATS
    // =================================
    match /groups/{groupId} {
      // A user can read (get/list) a group's data ONLY if they are a member.
      // This works with the client query: `where('memberIds', 'array-contains', auth.uid)`.
      allow read: if request.auth.uid in resource.data.memberIds;
      
      // A user can create a group ONLY if they are the creator and are included in the member list.
      allow create: if request.resource.data.creatorId == request.auth.uid && 
                     request.auth.uid in request.resource.data.memberIds;

      // The creator or an admin can update group details (e.g., name, description).
      allow update: if resource.data.creatorId == request.auth.uid || 
                     exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));

      // The creator or an admin can delete a group.
      allow delete: if resource.data.creatorId == request.auth.uid || 
                     exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      
      // --- NESTED: GROUP MESSAGES ---
      match /messages/{messageId} {
        // A user can read messages if they are a member of the parent group.
        // This requires a 'get()' call, which has a small performance cost but is very secure.
        allow read: if request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        
        // A user can create a message if they are the sender and a member of the group.
        allow create: if request.resource.data.senderId == request.auth.uid &&
                       request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        // Group messages are immutable for now.
        allow update, delete: if false;
      }
    }

    // =================================
    //     STATUS UPDATES
    // =================================
    match /status_updates/{statusId} {
      // Any logged-in user can read status updates.
      allow read: if request.auth != null;
      
      // A user can only create a status for themselves.
      allow create: if request.resource.data.userId == request.auth.uid;
      
      // Anyone can update 'likes' and 'views', but only the owner can change other fields.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'views']) || 
                     (request.auth.uid == resource.data.userId);
                     
      // The owner or an admin can delete a status.
      allow delete: if request.auth.uid == resource.data.userId || 
                     exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // =================================
    //     AFFILIATE PRODUCTS
    // =================================
    match /affiliate_products/{productId} {
      // Any logged-in user can view products.
      allow read: if request.auth != null;
      
      // Only admins can add, update, or delete products.
      allow write: if exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}
