rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to list all profiles for discovery, but only get/write their own.
    match /users/{userId} {
      allow list: if request.auth != null;
      allow get, write: if request.auth.uid == userId;
    }

    // CRITICAL FIX: This is a recursive wildcard rule. It grants a user
    // full read/write access to ANY document in ANY sub-collection
    // under their own user document. This explicitly includes the
    // /users/{userId}/chats path that was causing the error.
    match /users/{userId}/{documents=**} {
      allow read, write: if request.auth.uid == userId;
    }

    // Secures one-on-one chat messages.
    match /chats/{chatId}/messages/{messageId} {
      function isChatParticipant() {
        return request.auth.uid in chatId.split('_');
      }
      function isSender() {
        return request.auth.uid == resource.data.senderId;
      }
      allow read, create: if isChatParticipant();
      allow delete: if isSender();
      allow update: if false; // Messages are immutable
    }

    // Secures status updates.
    match /status_updates/{statusId} {
      function isOwner() {
        return request.auth.uid == resource.data.userId;
      }
      function isCreatingOwnStatus() {
         return request.auth.uid == request.resource.data.userId;
      }
      function isUpdatingLikesOrViews() {
        let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return affectedKeys.hasOnly(['likes', 'views']) || affectedKeys.hasOnly(['likes']) || affectedKeys.hasOnly(['views']);
      }
      allow read: if request.auth != null;
      allow create: if isCreatingOwnStatus();
      allow update: if request.auth != null && isUpdatingLikesOrViews();
      allow delete: if isOwner();
    }

    // Secures group chats.
    match /groups/{groupId} {
      function isMember() {
        return request.auth.uid in resource.data.memberIds;
      }
      function isCreator() {
        return request.auth.uid == resource.data.creatorId;
      }
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.creatorId;
      allow update: if isMember();
      allow delete: if isCreator();
    }

    // Secures group chat messages.
    match /groups/{groupId}/messages/{messageId} {
      function isGroupMember(groupId) {
          return get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds.hasAny([request.auth.uid]);
      }
      allow read, create: if isGroupMember(groupId);
      allow update, delete: if false;
    }

    // Secures affiliate products, readable by all, writable only by admin.
    match /affiliate_products/{productId} {
      function isAdmin() {
        return request.auth.token.email == 'fahadkhanamrohivi@gmail.com';
      }
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

     // Secures admin roles, only manageable by admin.
    match /roles_admin/{userId} {
       function isAdmin() {
         return request.auth.token.email == 'fahadkhanamrohivi@gmail.com';
       }
       allow read, write: if isAdmin();
    }
  }
}
