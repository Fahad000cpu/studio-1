
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Allow reading/listing of profiles for discovery by any authenticated user.
      allow get, list: if request.auth != null;
      // Allow a user to write only to their own profile.
      allow write: if request.auth.uid == userId;
    }

    match /chats/{chatId}/messages/{messageId} {
      // A user can create a message if they are the sender.
      allow create: if request.auth.uid == request.resource.data.senderId;

      // Reading (list or get) is allowed if the user is a participant in the chat.
      allow read: if request.auth.uid in chatId.split('_');
      
      // Updating (like "delete for me") is allowed if the user is a participant in the chat.
      // We rely on the chatId for this, as it's a more reliable source of authorization.
      allow update: if request.auth.uid in chatId.split('_');

      // Deleting (for everyone) is only allowed for the original sender.
      allow delete: if request.auth.uid == resource.data.senderId;
    }

    // Statuses can be read by anyone, but only written/deleted by the owner.
    match /status_updates/{statusUpdateId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }

    // Affiliate products can be read by anyone, but only written by an admin.
    match /affiliate_products/{productId} {
      allow read: if request.auth != null;
      allow write: if exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Admin roles rules
    match /roles_admin/{userId} {
      // A user can get their own role doc, and an admin can get any role doc.
      allow get: if request.auth.uid == userId || exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      
      // An existing admin can list all roles.
      allow list: if exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      
      // Only allow existing admins to create, update, or delete admin roles.
      allow write: if exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}
