
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- USER PROFILE RULES ---
    // A user can see other user profiles (for discover page).
    // A user can only modify their own profile.
    match /users/{userId} {
      allow get, list: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // --- USER CHAT METADATA RULES ---
    // This rule applies to documents inside the 'chats' subcollection.
    // e.g., /users/USER_A/chats/USER_B
    match /users/{userId}/chats/{chatId} {
      // Allow a user to read (get, list) their own chat metadata.
      // This is what allows the query on the 'chats' collection to succeed.
      allow read: if request.auth.uid == userId;

      // Allow a user to write (create, update, delete) their own chat metadata.
      allow write: if request.auth.uid == userId;
    }

    // --- OTHER TOP-LEVEL COLLECTIONS ---

    match /status_updates/{statusId} {
        function isOwner() {
          return request.auth != null && request.auth.uid == resource.data.userId;
        }
        function isCreatingOwnStatus() {
           return request.auth != null && request.auth.uid == request.resource.data.userId;
        }
        function isUpdatingLikesOrViews() {
          let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
          return affectedKeys.hasOnly(['likes', 'views']) || affectedKeys.hasOnly(['likes']) || affectedKeys.hasOnly(['views']);
        }
        allow read: if request.auth != null;
        allow create: if isCreatingOwnStatus();
        allow update: if request.auth != null && isUpdatingLikesOrViews();
        allow delete: if isOwner();
    }

    match /chats/{chatId}/messages/{messageId} {
      function isChatParticipant() {
        return request.auth != null && request.auth.uid in chatId.split('_');
      }
      function isSender() {
        return request.auth != null && request.auth.uid == resource.data.senderId;
      }
      // Participants can read messages and create new ones.
      allow read, create: if isChatParticipant();
      
      // "Delete for me" is an update. A participant should be able to update.
      allow update: if isChatParticipant();

      // Only the original sender can delete the message for everyone.
      allow delete: if isSender();
    }

    match /groups/{groupId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.memberIds;
      }
      function isGroupCreator() {
        return isSignedIn() && resource.data.creatorId == request.auth.uid;
      }
      allow get, list: if isSignedIn();
      allow create: if request.auth != null && request.resource.data.creatorId == request.auth.uid;
      allow update: if isMember();
      allow delete: if isGroupCreator();
    }

    match /groups/{groupId}/messages/{messageId} {
      function isGroupMember() {
          // Note: This relies on a `get` call which can be inefficient.
          // For better performance, the group members should be denormalized into the message document.
          return request.auth != null && get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds.hasAny([request.auth.uid]);
      }
      allow get, list: if isGroupMember();
      allow create: if isGroupMember() && request.resource.data.groupId == groupId;
      allow update, delete: if false; // Group messages are immutable
    }

    match /affiliate_products/{productId} {
      function isAdmin() {
          return request.auth != null && request.auth.token.email == 'fahadkhanamrohivi@gmail.com';
      }
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /roles_admin/{userId} {
       function isAdmin() {
           return request.auth != null && request.auth.token.email == 'fahadkhanamrohivi@gmail.com';
       }
       allow get, list, create, delete: if isAdmin();
       allow update: if false;
    }
  }
}
