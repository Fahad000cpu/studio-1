rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================
    //     HELPER FUNCTIONS
    // =================================
    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isLoggedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // =================================
    //     USER PROFILES
    // =================================
    match /users/{userId} {
      allow get, list: if isLoggedIn();
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }

    // =================================
    //     ADMIN ROLES
    // =================================
    match /roles_admin/{userId} {
      allow get: if isLoggedIn();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    // =================================
    //     1-on-1 CHAT METADATA (TOP-LEVEL)
    // =================================
    match /chat_metadata/{chatId} {
      // A user can GET a specific chat's metadata if they are a participant.
      allow get: if isLoggedIn() && request.auth.uid in resource.data.participants;

      // A user can LIST chats. This authorizes the client-side query which MUST
      // be constrained (e.g., where('participants', 'array-contains', auth.uid)).
      allow list: if isLoggedIn();

      // A user can CREATE metadata if they are one of the participants in the new document.
      allow create: if isLoggedIn() && request.auth.uid in request.resource.data.participants;

      // A user can UPDATE metadata (e.g., last message) if they are already a participant in that chat.
      allow update: if isLoggedIn() && get(/databases/$(database)/documents/chat_metadata/$(chatId)).data.participants.hasAny([request.auth.uid]);
    }

    // =================================
    //     1-on-1 CHAT MESSAGES
    // =================================
    match /chats/{chatId}/messages/{messageId} {
      function isParticipant() {
        return isLoggedIn() && (request.auth.uid in chatId.split('_'));
      }
      allow read: if isParticipant();
      allow create: if isParticipant() && request.resource.data.senderId == request.auth.uid;
      allow update: if isParticipant(); // For "delete for me"
      allow delete: if isLoggedIn() && resource.data.senderId == request.auth.uid; // For "delete for everyone"
    }

    // =================================
    //     GROUP CHATS
    // =================================
    match /groups/{groupId} {
      function isMember() {
        return isLoggedIn() && request.auth.uid in resource.data.memberIds;
      }
      function isCreator() {
        return isLoggedIn() && request.auth.uid == resource.data.creatorId;
      }
      
      // A user can GET a group if they are a member.
      allow get: if isMember();

      // A user can LIST groups. This authorizes the client-side query which MUST
      // be constrained (e.g., where('memberIds', 'array-contains', auth.uid)).
      allow list: if isLoggedIn();
      
      // A user can CREATE a group if they are the creator and included in the member list.
      allow create: if isLoggedIn() &&
                     request.resource.data.creatorId == request.auth.uid &&
                     request.auth.uid in request.resource.data.memberIds;

      // The creator or an admin can UPDATE group details.
      allow update: if isCreator() || isAdmin();

      // The creator or an admin can DELETE a group.
      allow delete: if isCreator() || isAdmin();
      
      // --- NESTED: GROUP MESSAGES ---
      match /messages/{messageId} {
        function isGroupMember() {
            return isLoggedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }
        allow read: if isGroupMember();
        allow create: if isGroupMember() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // =================================
    //     STATUS UPDATES
    // =================================
    match /status_updates/{statusId} {
      function isOwner() {
        return isLoggedIn() && request.auth.uid == resource.data.userId;
      }
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isLoggedIn() && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'views']) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
      allow delete: if isOwner() || isAdmin();
    }

    // =================================
    //     AFFILIATE PRODUCTS
    // =================================
    match /affiliate_products/{productId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }
  }
}
