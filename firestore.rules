rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated.
    function isLoggedIn() {
      return request.auth != null;
    }

    // Helper function to check for admin role.
    function isAdmin() {
      return isLoggedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // =================================
    //     USER PROFILES
    // =================================
    match /users/{userId} {
      // Any logged-in user can get or list profiles.
      allow get, list: if isLoggedIn();
      
      // A user can create their own profile document.
      allow create: if request.auth.uid == userId;

      // A user can update their own profile, or an admin can update any profile.
      allow update: if (request.auth.uid == userId) || isAdmin();

      // Only admins can delete user profiles.
      allow delete: if isAdmin();
    }

    // =================================
    //     ADMIN ROLES
    // =================================
    match /roles_admin/{userId} {
      // Only an admin can read the admin roles list.
      allow read: if isAdmin();
      
      // Only an admin can grant or revoke admin roles.
      allow write: if isAdmin();
    }

    // =================================
    //     1-on-1 CHAT METADATA
    // =================================
    match /chat_metadata/{chatId} {
      // A user can read (get/list) metadata if their UID is part of the document ID.
      // This is a more robust way to secure list queries as it doesn't rely on `resource.data`.
      // The client query `where('participants', 'array-contains', uid)` finds the documents,
      // and this rule secures access to them based on their ID.
      allow read: if isLoggedIn() && request.auth.uid in chatId.split('_');

      // A user can create new chat metadata ONLY if they are included in the participants list
      // AND their UID is part of the chatId.
      allow create: if isLoggedIn() && request.auth.uid in request.resource.data.participants && request.auth.uid in chatId.split('_');

      // A user can update metadata (like last message) if they are a participant.
      // Checking the chatId is sufficient and more efficient than a get() call.
      allow update: if isLoggedIn() && request.auth.uid in chatId.split('_');
      
      // Deleting chat metadata is not allowed for users.
      allow delete: if false;
    }

    // =================================
    //     1-on-1 CHAT MESSAGES
    // =================================
    match /chats/{chatId}/messages/{messageId} {
      // A user can read/write messages in a chat ONLY if their UID is part of the chatId.
      // This pattern assumes chatId is 'uid1_uid2'.
      allow read, write: if isLoggedIn() && request.auth.uid in chatId.split('_');
    }

    // =================================
    //     GROUP CHATS
    // =================================
    match /groups/{groupId} {
      // A user can read (get/list) a group's data ONLY if they are a member.
      // This works with the client query: `where('memberIds', 'array-contains', auth.uid)`.
      // This rule is also now "bulletproof" against malformed documents.
      allow read: if isLoggedIn() && 'memberIds' in resource.data && request.auth.uid in resource.data.memberIds;
      
      // A user can create a group ONLY if they are the creator and are included in the member list.
      allow create: if isLoggedIn() && request.resource.data.creatorId == request.auth.uid && 
                     request.auth.uid in request.resource.data.memberIds;

      // The creator or an admin can update group details (e.g., name, description).
      allow update: if (isLoggedIn() && get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId == request.auth.uid) || isAdmin();

      // The creator or an admin can delete a group.
      allow delete: if (isLoggedIn() && resource.data.creatorId == request.auth.uid) || isAdmin();
      
      // --- NESTED: GROUP MESSAGES ---
      match /messages/{messageId} {
        // A user can read messages if they are a member of the parent group.
        // This requires a 'get()' call, which has a small performance cost but is very secure.
        allow read: if isLoggedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        
        // A user can create a message if they are the sender and a member of the group.
        allow create: if isLoggedIn() && request.resource.data.senderId == request.auth.uid &&
                       request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        // Group messages are immutable for now.
        allow update, delete: if false;
      }
    }

    // =================================
    //     STATUS UPDATES
    // =================================
    match /status_updates/{statusId} {
      // Any logged-in user can read status updates.
      allow read: if isLoggedIn();
      
      // A user can only create a status for themselves.
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      
      // Anyone can update 'likes' and 'views', but only the owner can change other fields.
      allow update: if (isLoggedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'views'])) || 
                     (isLoggedIn() && request.auth.uid == resource.data.userId);
                     
      // The owner or an admin can delete a status.
      allow delete: if (isLoggedIn() && request.auth.uid == resource.data.userId) || isAdmin();
    }

    // =================================
    //     AFFILIATE PRODUCTS
    // =================================
    match /affiliate_products/{productId} {
      // Any logged-in user can view products.
      allow read: if isLoggedIn();
      
      // Only admins can add, update, or delete products.
      allow write: if isAdmin();
    }
  }
}
