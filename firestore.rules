
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // This single rule grants a user full access to their own document and all sub-collections within it.
    // It covers the user's profile, their chat list, and any other data stored under their user ID.
    match /users/{userId}/{documents=**} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Any authenticated user can list the main user collection to discover other users.
    match /users/{userId} {
      allow list: if request.auth != null;
    }

    // Rule for messages within a one-to-one chat. These are in a top-level collection.
    match /chats/{chatId}/messages/{messageId} {
      function isChatParticipant() {
        return request.auth != null && request.auth.uid in chatId.split('_');
      }
      function isSender() {
        return request.auth != null && request.auth.uid == resource.data.senderId;
      }
      allow read, create: if isChatParticipant();
      allow delete: if isSender();
      allow update: if false; 
    }

    // Rule for status updates
    match /status_updates/{statusId} {
        function isOwner() {
          return request.auth != null && request.auth.uid == resource.data.userId;
        }
        function isCreatingOwnStatus() {
           return request.auth != null && request.auth.uid == request.resource.data.userId;
        }
        
        function isUpdatingLikesOrViews() {
          let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
          return affectedKeys.hasOnly(['likes', 'views']) || affectedKeys.hasOnly(['likes']) || affectedKeys.hasOnly(['views']);
        }

        allow read: if request.auth != null;
        allow create: if isCreatingOwnStatus();
        allow update: if request.auth != null && isUpdatingLikesOrViews();
        allow delete: if isOwner();
    }

    // Rule for chat group metadata
    match /chat_groups/{groupId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.memberIds;
      }
      function isGroupCreator() {
        return isSignedIn() && resource.data.creatorId == request.auth.uid;
      }
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if request.auth.uid != null && request.resource.data.creatorId == request.auth.uid;
      allow update: if isMember();
      allow delete: if isGroupCreator();
    }

    // Rule for messages within a group chat
    match /chat_groups/{groupId}/messages/{messageId} {
      function isMemberInGroup() {
          return request.auth != null && get(/databases/$(database)/documents/chat_groups/$(groupId)).data.memberIds.hasAny([request.auth.uid]);
      }
      allow read, create: if isMemberInGroup();
      allow update, delete: if false; // Messages are immutable
    }

    // Rule for affiliate products
    match /affiliate_products/{productId} {
      function isAdmin() {
          return request.auth != null && request.auth.token.email == 'fahadkhanamrohivi@gmail.com';
      }
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Rule for admin role documents
    match /roles_admin/{userId} {
       function isAdmin() {
         return request.auth.token.email == 'fahadkhanamrohivi@gmail.com';
       }
       allow read, write: if isAdmin();
    }
  }
}
