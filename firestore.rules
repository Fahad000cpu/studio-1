
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- USER PROFILE RULES ---
    match /users/{userId} {
      // Any authenticated user can read profiles.
      allow get, list: if request.auth != null;
      
      // A user can create their own profile.
      allow create: if request.auth.uid == userId;

      // A user can update their own profile, or an admin can update any profile.
      allow update: if request.auth.uid == userId || exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));

      // Only admins can delete user profiles.
      allow delete: if exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));

      // --- NEW SUBCOLLECTION RULE for 1-on-1 Chat Metadata ---
      match /chats/{chatId} {
        // A user can only read and write to their own chat metadata subcollection.
        // This is secure because the query path is already scoped to the user's UID.
        allow read, write: if request.auth.uid == userId;
      }
    }

    // --- ADMIN ROLE RULES ---
    match /roles_admin/{userId} {
      // Only admins can read or write roles.
      allow read, write: if request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- 1-on-1 CHAT MESSAGES ---
    match /chats/{chatId}/messages/{messageId} {
      // A user can read/write messages in a chat ONLY if their UID is part of the chatId (e.g., 'uid1_uid2').
      // This is a simple and effective rule for 1-on-1 chats stored this way.
      allow read, write: if request.auth != null && request.auth.uid in chatId.split('_');
    }

    // --- GROUP CHAT RULES ---
    match /groups/{groupId} {
      // A user can read a group's info (both get and list) if they are a member.
      // This relies on the client-side query using `where('memberIds', 'array-contains', uid)`.
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      
      // A user can create a group IF they are the creator AND are in the member list.
      allow create: if request.auth != null && 
                     request.resource.data.creatorId == request.auth.uid &&
                     'memberIds' in request.resource.data &&
                     request.resource.data.memberIds is list &&
                     request.auth.uid in request.resource.data.memberIds;

      // The creator or an admin can update group details.
      allow update: if (request.auth != null && get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId == request.auth.uid) || (request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)));

      // The creator or an admin can delete a group.
      allow delete: if (request.auth != null && resource.data.creatorId == request.auth.uid) || (request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)));
      
      // --- NESTED: GROUP MESSAGES ---
      match /messages/{messageId} {
        // READ: User can read a message if they are in its memberIds list.
        // This is enforced by the client query using `where('memberIds', 'array-contains', uid)`.
        allow read: if request.auth != null && 
                     request.auth.uid in resource.data.memberIds;

        // CREATE: User can create a message if they are a group member.
        // The new message must correctly denormalize the group's member list.
        allow create: if request.auth != null &&
                       request.resource.data.senderId == request.auth.uid &&
                       request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds &&
                       request.resource.data.memberIds == get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        // UPDATE: User can "delete for me" by adding their UID to the deletedFor list.
        // They must be a member of the group to do this.
        allow update: if request.auth != null &&
                       request.auth.uid in resource.data.memberIds &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor']) &&
                       request.resource.data.deletedFor == resource.data.deletedFor.insert(request.auth.uid);

        // DELETE: The sender of the message can delete it for everyone.
        allow delete: if request.auth != null && 
                       request.auth.uid == resource.data.senderId;
      }
    }

    // --- STATUS UPDATE RULES ---
    match /status_updates/{statusId} {
      // Any logged-in user can read status updates.
      allow read: if request.auth != null;
      
      // A user can only create a status for themselves.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Anyone can update 'likes' and 'views', but only the owner can change other fields.
      allow update: if (request.auth != null && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'views']) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']))) || 
                     (request.auth != null && request.auth.uid == resource.data.userId);
                     
      // The owner or an admin can delete a status.
      allow delete: if (request.auth != null && request.auth.uid == resource.data.userId) || (request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)));
    }

    // --- AFFILIATE PRODUCT RULES ---
    match /affiliate_products/{productId} {
      // Any logged-in user can view products.
      allow read: if request.auth != null;
      
      // Only admins can add, update, or delete products.
      allow write: if request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}
